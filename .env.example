# Copia este archivo a .env.local y rellena los valores.
#
# LOCAL:       los que imprime `supabase status`.
# PRODUCCION:  panel de Supabase (Project Settings > API) + dominio de Vercel.
#
# NUNCA apuntar el entorno de desarrollo a la base de produccion.

# URL del proyecto Supabase (termina en .supabase.co en produccion)
NEXT_PUBLIC_SUPABASE_URL=

# Clave publishable (antes "anon key"). Va al navegador, sujeta a RLS.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Clave secreta (antes "service_role key"). SOLO servidor, se salta la RLS.
# Jamas con prefijo NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=

# URL publica de la app. En local http://127.0.0.1:3000; en produccion el
# dominio de Vercel. Debe coincidir con auth.site_url del proyecto Supabase.
NEXT_PUBLIC_SITE_URL=
